pipeline {
    agent any
    
    // Variables d'environnement
    environment {
        MAVEN_HOME = tool 'Maven'
        PATH = "${MAVEN_HOME}/bin:${env.PATH}"
        JAVA_HOME = tool 'JDK'
    }
    
    // Options du pipeline
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }
    
    // Déclencheurs automatiques
    triggers {
        pollSCM('H/5 * * * *') // Vérifie Git toutes les 5 minutes
        // cron('H 2 * * *') // Build quotidien à 2h du matin
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Récupération du code source depuis Git...'
                git branch: 'main',
                    url: 'https://github.com/mhassini/avec-maven.git'
                    // Pour un dépôt privé, ajoutez :
                    // credentialsId: 'votre-credential-id'
            }
        }
        
        stage('Informations Environnement') {
            steps {
                echo '🔍 Affichage des informations d\'environnement...'
                sh '''
                    echo "Java version:"
                    java -version
                    echo "\nMaven version:"
                    mvn -version
                    echo "\nRépertoire de travail:"
                    pwd
                    echo "\nContenu du répertoire:"
                    ls -la
                '''
            }
        }
        
        stage('Build') {
            steps {
                echo '🔨 Compilation du projet Maven...'
                sh 'mvn clean compile'
            }
        }
        
        stage('Tests Unitaires') {
            steps {
                echo '🧪 Exécution des tests unitaires...'
                sh 'mvn test'
            }
            post {
                always {
                    // Publie les résultats des tests
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Analyse Qualité') {
            steps {
                echo '📊 Analyse de la qualité du code...'
                sh 'mvn checkstyle:checkstyle || true'
                // Le '|| true' permet de continuer même si checkstyle trouve des problèmes
            }
        }
        
        stage('Package') {
            steps {
                echo '📦 Création du package (JAR/WAR)...'
                sh 'mvn package -DskipTests'
            }
            post {
                success {
                    // Archive les artifacts générés
                    archiveArtifacts artifacts: '**/target/*.jar,**/target/*.war', 
                                     fingerprint: true,
                                     allowEmptyArchive: true
                }
            }
        }
        
        stage('Installation') {
            steps {
                echo '💾 Installation dans le dépôt local Maven...'
                sh 'mvn install -DskipTests'
            }
        }
        
        stage('Déploiement') {
            when {
                branch 'main' // Déploie uniquement depuis la branche main
            }
            steps {
                echo '🚀 Déploiement de l\'application...'
                // Ajoutez ici vos commandes de déploiement
                sh '''
                    echo "Déploiement simulé..."
                    # Exemples :
                    # scp target/*.war user@server:/opt/tomcat/webapps/
                    # docker build -t mon-app .
                    # kubectl apply -f deployment.yaml
                '''
            }
        }
    }
    
    post {
        success {
            echo '✅ Build réussi !'
            // Notification email (si configuré)
            // emailext subject: "✅ Build #${BUILD_NUMBER} - SUCCESS",
            //          body: "Le build ${JOB_NAME} #${BUILD_NUMBER} a réussi.",
            //          to: 'votre-email@example.com'
        }
        failure {
            echo '❌ Build échoué !'
            // Notification email en cas d'échec
            // emailext subject: "❌ Build #${BUILD_NUMBER} - FAILED",
            //          body: "Le build ${JOB_NAME} #${BUILD_NUMBER} a échoué.\nVoir: ${BUILD_URL}",
            //          to: 'votre-email@example.com'
        }
        always {
            echo '🧹 Nettoyage de l\'espace de travail...'
            cleanWs()
        }
    }
}
